# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values. ".env" is gitignored - never commit real secrets.

# MySQL root password, also used by the backend to connect.
DB_PASSWORD=change-me

# HMAC signing key for JWTs. Must be a long random string (32+ bytes).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional - defaults shown. Both are in milliseconds.
JWT_EXPIRATION=900000
JWT_REFRESH=604800000

# Optional - the backend URL the *browser* will call. Only change this if you
# are exposing the stack somewhere other than localhost (e.g. a server IP or
# domain), since this gets baked into the frontend build.
PUBLIC_API_URL=http://localhost:8080
